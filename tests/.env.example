# Copy this file to .env and fill in real values from your Supabase project.
# Follow docs/supabase-setup.md.
#
# Missing file or keys => all live tests SKIP (so CI without a
# Supabase project stays green). They never pass silently: the skip
# reason names what is missing.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
