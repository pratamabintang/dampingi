# Copy this file to .env and fill in real values.
# Follow docs/supabase-setup.md to create the project and get values.

# Application
APP_ENV=development
# Render sets this automatically; used by uvicorn locally
PORT=8000

# Supabase project
# e.g. https://abcdxxxx.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy service_role key — server-side only!
SUPABASE_SECRET_KEY=
