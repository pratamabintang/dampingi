# Copy this file to .env and fill in real values.

# Application
APP_ENV=development
# Render sets this automatically; used by uvicorn locally
PORT=8000

# Secret key for signing tokens/sessions (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Database (optional, placeholder for future use)
# DATABASE_URL=postgresql://user:password@host:5432/dampingi
